 <div class="blog">
  <h1><%= @blog.name %></h1>


  <hr>

  <h2>Articles de ce blog</h2>

  <%= link_to "Nouvel article", new_blog_post_path(@blog) %>

  <ul>
    <% @posts.each do |post| %>
      <li>
        <strong>
          <%= link_to post.title, blog_post_path(@blog, post) %>
        </strong>
        <% if post.created_at.present? %>
          <small>(publié le <%= l(post.created_at, format: :short) rescue post.created_at %>)</small>
        <% end %>
      </li>
    <% end %>
  </ul>


 </div>
  