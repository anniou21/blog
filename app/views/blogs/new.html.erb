<h1>Nouveau Blog</h1>

<%= form_with model: @blog do |f| %>
  <div>
    <%= f.label :title, "Titre" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :description, "Description" %><br>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.submit "Créer le blog" %>
  </div>
<% end %>

<%= link_to "Retour", blogs_path %>
