<h1><%= @blog.title %></h1>
<p><%= @blog.description %></p>

<hr>

<h2>Articles de ce blog</h2>

<%= link_to "Nouvel article", new_blog_post_path(@blog) %>

<ul>
  <% @posts.each do |post| %>
    <li>
      <strong>
        <%= link_to post.title, blog_post_path(@blog, post) %>
      </strong>
      <% if post.published_at.present? %>
        <small>(publié le <%= l(post.published_at, format: :short) rescue post.published_at %>)</small>
      <% end %>
    </li>
  <% end %>
</ul>
