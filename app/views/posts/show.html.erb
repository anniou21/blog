<h1><%= @post.title %></h1>

<p><%= simple_format(@post.body) %></p>

<% if @post.published_at.present? %>
  <p><em>Publié le <%= l(@post.published_at, format: :long) rescue @post.published_at %></em></p>
<% end %>

<hr>

<div>
  <%= link_to "Modifier cet article", edit_post_path(@post) %> |
  <%= link_to "Retour aux articles", blog_posts_path(@post.blog) %> |
  <%= link_to "Retour au blog", blog_path(@post.blog) %>
</div>

<hr>

<h2>Commentaires</h2>

<% @comments.each do |comment| %>
  <div>
    <strong><%= comment.author_name %></strong><br>
    <p><%= simple_format(comment.body) %></p>
    <%= link_to "Supprimer", blog_post_comment_path(@post.blog, @post, comment),
                data: { turbo_method: :delete, turbo_confirm: "Supprimer ce commentaire ?" } %>
  </div>
  <hr>
<% end %>

<h3>Ajouter un commentaire</h3>

<%= form_with model: [@post.blog, @post, @comment] do |f| %>
  <div>
    <%= f.label :author_name, "Votre nom" %><br>
    <%= f.text_field :author_name %>
  </div>

  <div>
    <%= f.label :body, "Commentaire" %><br>
    <%= f.text_area :body, rows: 4 %>
  </div>

  <div>
    <%= f.submit "Publier le commentaire" %>
  </div>
<% end %>
