<%= form_with model: [@blog, post] do |f| %>
  <div>
    <%= f.label :title, "Titre" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :body, "Contenu" %><br>
    <%= f.text_area :body, rows: 10 %>
  </div>

  <div>
    <%= f.label :published_at, "Date de publication" %><br>
    <%= f.datetime_select :published_at %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
